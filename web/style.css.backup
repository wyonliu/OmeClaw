/* ========== 全局样式 ========== */
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}

:root{
  /* 颜色系统 */
  --bg:#0a0a0f;
  --surface:#13131a;
  --surface2:#1e1e2a;
  --border:#2a2a3a;
  --text:#eeeef2;
  --text2:#8888a0;
  --accent:#7c6cf0;
  --accent-dark:#6b5ce0;
  --accent-light:#9d8fff;
  --green:#00d47b;
  --orange:#ffa040;
  --red:#ff5050;
  --blue:#4d9fff;
  
  /* 间距 */
  --safe-bottom:env(safe-area-inset-bottom,0px);
  --nav-height:64px;
  
  /* 字体 */
  --font:-apple-system,BlinkMacSystemFont,"SF Pro","Segoe UI",system-ui,sans-serif;
}

body{
  font-family:var(--font);
  background:var(--bg);
  color:var(--text);
  font-size:15px;
  line-height:1.5;
  overflow:hidden;
  -webkit-font-smoothing:antialiased;
  -moz-osx-font-smoothing:grayscale;
}

.app{
  display:flex;
  flex-direction:column;
  height:100vh;
  height:100dvh;
}

/* ========== 主内容区 ========== */
.content{
  flex:1;
  overflow:hidden;
  position:relative;
  padding-bottom:calc(var(--nav-height) + var(--safe-bottom));
}

.view{
  display:none;
  flex-direction:column;
  height:100%;
  overflow:hidden;
}

.view.active{display:flex}

.subview{
  position:absolute;
  top:0;
  left:0;
  right:0;
  bottom:0;
  background:var(--bg);
  z-index:10;
  transform:translateX(100%);
  transition:transform .3s cubic-bezier(.4,0,.2,1);
}

.subview.active{transform:translateX(0)}

/* ========== 💬 对话页 ========== */
.chat-header{
  display:flex;
  align-items:center;
  gap:12px;
  padding:12px 16px;
  background:var(--surface);
  border-bottom:1px solid var(--border);
}

.avatar-status{
  position:relative;
  flex-shrink:0;
}

.avatar{
  width:44px;
  height:44px;
  border-radius:50%;
  background:linear-gradient(135deg,var(--accent),var(--blue));
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:24px;
}

.status-indicator{
  position:absolute;
  bottom:0;
  right:0;
  width:12px;
  height:12px;
  border-radius:50%;
  background:var(--green);
  border:2px solid var(--surface);
  animation:pulse 2s infinite;
}

@keyframes pulse{
  0%,100%{opacity:1}
  50%{opacity:.5}
}

.header-info{
  flex:1;
  min-width:0;
}

.header-info h1{
  font-size:17px;
  font-weight:600;
  margin:0;
}

.header-info p{
  font-size:13px;
  color:var(--text2);
  margin:0;
}

.header-actions{
  display:flex;
  gap:8px;
}

.icon-btn{
  width:36px;
  height:36px;
  border-radius:50%;
  border:none;
  background:var(--surface2);
  color:var(--text2);
  font-size:18px;
  display:flex;
  align-items:center;
  justify-content:center;
  cursor:pointer;
  transition:all .2s;
}

.icon-btn:active{
  transform:scale(.9);
  background:var(--border);
}

/* 消息列表 */
.messages{
  flex:1;
  overflow-y:auto;
  padding:16px;
  display:flex;
  flex-direction:column;
  gap:12px;
  scroll-behavior:smooth;
}

.msg{
  max-width:80%;
  padding:12px 16px;
  border-radius:20px;
  font-size:15px;
  line-height:1.5;
  word-break:break-word;
  animation:msgSlide .3s cubic-bezier(.4,0,.2,1);
}

@keyframes msgSlide{
  from{opacity:0;transform:translateY(10px)}
  to{opacity:1;transform:translateY(0)}
}

.msg.user{
  align-self:flex-end;
  background:var(--accent);
  color:#fff;
  border-bottom-right-radius:6px;
}

.msg.assistant{
  align-self:flex-start;
  background:var(--surface);
  border:1px solid var(--border);
  border-bottom-left-radius:6px;
}

.msg.thinking{
  background:var(--surface2);
}

.thinking-dots{
  display:flex;
  gap:4px;
  padding:4px 0;
}

.thinking-dots span{
  width:8px;
  height:8px;
  border-radius:50%;
  background:var(--accent);
  animation:bounce 1.4s infinite ease-in-out;
}

.thinking-dots span:nth-child(1){animation-delay:-0.32s}
.thinking-dots span:nth-child(2){animation-delay:-0.16s}
.thinking-dots span:nth-child(3){animation-delay:0}

@keyframes bounce{
  0%,80%,100%{transform:scale(.5);opacity:.3}
  40%{transform:scale(1);opacity:1}
}

/* 每日话题 */
.daily-topic{
  margin:0 16px 12px;
  padding:12px 16px;
  background:linear-gradient(135deg,rgba(124,108,240,.1),rgba(77,159,255,.05));
  border:1px solid rgba(124,108,240,.2);
  border-radius:16px;
  display:flex;
  align-items:center;
  gap:10px;
  cursor:pointer;
  transition:all .2s;
}

.daily-topic:active{
  transform:scale(.98);
}

.topic-icon{font-size:20px}
.topic-text{font-size:14px;color:var(--text);flex:1}

/* 输入栏 */
.chat-input-bar{
  display:flex;
  align-items:center;
  gap:10px;
  padding:12px 16px;
  background:var(--surface);
  border-top:1px solid var(--border);
}

.voice-btn{
  position:relative;
  width:48px;
  height:48px;
  border-radius:50%;
  border:none;
  background:linear-gradient(135deg,#7c6cf0,#4d9fff);
  color:white;
  font-size:22px;
  display:flex;
  align-items:center;
  justify-content:center;
  cursor:pointer;
  transition:all .3s cubic-bezier(.4,0,.2,1);
  flex-shrink:0;
  box-shadow:0 4px 12px rgba(124,108,240,.3);
}

.voice-btn:hover{
  transform:scale(1.08);
  box-shadow:0 6px 16px rgba(124,108,240,.5);
}

.voice-btn:active{
  transform:scale(.92);
}

.voice-btn.recording{
  background:linear-gradient(135deg,#ff5050,#ff8080);
  animation:voicePulse 1.2s ease-in-out infinite;
  box-shadow:0 4px 16px rgba(255,80,80,.5);
}

@keyframes voicePulse{
  0%,100%{
    transform:scale(1);
    box-shadow:0 4px 16px rgba(255,80,80,.5);
  }
  50%{
    transform:scale(1.1);
    box-shadow:0 6px 20px rgba(255,80,80,.7);
  }
}

.voice-wave{
  display:none;
  position:absolute;
  inset:0;
  border-radius:50%;
  border:2px solid currentColor;
  animation:waveExpand 1.5s ease-out infinite;
}

.voice-btn.recording .voice-wave{display:block}

@keyframes waveExpand{
  0%{transform:scale(1);opacity:.8}
  100%{transform:scale(2);opacity:0}
}

#chat-input{
  flex:1;
  padding:12px 16px;
  background:var(--bg);
  border:1px solid var(--border);
  border-radius:22px;
  color:var(--text);
  font-size:15px;
  font-family:var(--font);
  outline:none;
  transition:border-color .2s;
}

#chat-input:focus{
  border-color:var(--accent);
}

.send-btn{
  width:44px;
  height:44px;
  border-radius:50%;
  border:none;
  background:var(--accent);
  color:#fff;
  display:flex;
  align-items:center;
  justify-content:center;
  cursor:pointer;
  transition:all .2s;
  flex-shrink:0;
}

.send-btn:active{
  transform:scale(.9);
  background:var(--accent-dark);
}

/* ========== 🧠 记忆页 ========== */
.view-header-simple{
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:16px;
  background:var(--surface);
  border-bottom:1px solid var(--border);
}

.view-header-simple h2{
  font-size:20px;
  font-weight:700;
  margin:0;
}

.header-btns{
  display:flex;
  gap:8px;
}

.memory-hero{
  padding:16px;
  text-align:center;
  background:linear-gradient(180deg,var(--surface),var(--bg));
}

#memory-planet{
  display:block;
  margin:0 auto 12px;
  max-width:200px;
  height:200px;
}

.memory-stats{
  display:flex;
  justify-content:center;
  gap:32px;
}

.stat-item{
  display:flex;
  flex-direction:column;
  align-items:center;
}

.stat-value{
  font-size:24px;
  font-weight:700;
  color:var(--accent);
}

.stat-label{
  font-size:12px;
  color:var(--text2);
  margin-top:4px;
}

.memory-categories{
  flex:1;
  overflow-y:auto;
  padding:16px;
}

.mem-cat{
  background:var(--surface);
  border:1px solid var(--border);
  border-radius:16px;
  padding:16px;
  margin-bottom:12px;
  transition:all .2s;
}

.mem-cat.filled{
  border-left:3px solid var(--green);
}

.mem-cat-header{
  display:flex;
  align-items:center;
  gap:10px;
  margin-bottom:12px;
}

.mem-cat-icon{font-size:20px}

.mem-cat-name{
  flex:1;
  font-size:15px;
  font-weight:600;
}

.mem-cat-count{
  background:var(--green);
  color:#000;
  font-size:11px;
  font-weight:700;
  padding:2px 8px;
  border-radius:10px;
}

.mem-fact{
  display:flex;
  gap:8px;
  padding:8px 0;
  border-top:1px solid var(--border);
  font-size:14px;
}

.mem-fact:first-child{border-top:none;padding-top:0}

.mem-fact-key{
  color:var(--text2);
  min-width:70px;
  flex-shrink:0;
}

.mem-fact-val{
  color:var(--text);
  word-break:break-word;
}

/* ========== 🎯 养成页 ========== */
.grow-hero{
  padding:32px 16px;
  text-align:center;
  background:linear-gradient(180deg,var(--surface),var(--bg));
}

.grow-avatar{
  width:100px;
  height:100px;
  border-radius:50%;
  background:linear-gradient(135deg,var(--accent),var(--blue));
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:50px;
  margin:0 auto 16px;
  animation:float 4s ease-in-out infinite;
}

@keyframes float{
  0%,100%{transform:translateY(0)}
  50%{transform:translateY(-10px)}
}

.grow-hero h2{
  font-size:24px;
  font-weight:700;
  margin:0 0 4px;
}

.grow-hero p{
  font-size:15px;
  color:var(--text2);
  margin:0;
}

.bond-progress-card{
  margin:16px;
  padding:16px;
  background:var(--surface);
  border:1px solid var(--border);
  border-radius:16px;
}

.bond-bar{
  height:8px;
  background:var(--border);
  border-radius:4px;
  overflow:hidden;
  margin-bottom:12px;
}

.bond-fill{
  height:100%;
  background:linear-gradient(90deg,var(--accent),var(--blue));
  border-radius:4px;
  transition:width .5s cubic-bezier(.4,0,.2,1);
}

.bond-info{
  display:flex;
  justify-content:space-between;
  font-size:13px;
  color:var(--text2);
}

.streak-card{
  margin:0 16px 16px;
  padding:16px;
  background:linear-gradient(135deg,rgba(255,160,64,.1),rgba(255,80,80,.05));
  border:1px solid rgba(255,160,64,.2);
  border-radius:16px;
  display:flex;
  align-items:center;
  gap:16px;
}

.streak-icon{font-size:32px}

.streak-num{
  font-size:28px;
  font-weight:700;
  color:var(--orange);
  display:block;
}

.streak-label{
  font-size:13px;
  color:var(--text2);
}

.achievements-section,
.tasks-section{
  padding:0 16px 16px;
}

.achievements-section h3,
.tasks-section h3{
  font-size:17px;
  font-weight:600;
  margin-bottom:12px;
}

.achievements-grid{
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(100px,1fr));
  gap:12px;
}

.achievement{
  aspect-ratio:1;
  background:var(--surface);
  border:1px solid var(--border);
  border-radius:16px;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  gap:8px;
  padding:12px;
  text-align:center;
  transition:all .3s cubic-bezier(.4,0,.2,1);
  cursor:pointer;
  position:relative;
  overflow:hidden;
}

.achievement::before{
  content:"";
  position:absolute;
  inset:0;
  background:linear-gradient(135deg,rgba(124,108,240,.1),rgba(77,159,255,.05));
  opacity:0;
  transition:opacity .3s;
}

.achievement:hover{
  transform:translateY(-4px);
  box-shadow:0 8px 16px rgba(0,0,0,.2);
}

.achievement.unlocked{
  border-color:var(--accent);
  background:var(--accent-bg);
  animation:achievementUnlock .6s cubic-bezier(.4,0,.2,1);
}

.achievement.unlocked::before{
  opacity:1;
}

.achievement.unlocked:hover{
  transform:translateY(-4px) scale(1.05);
}

@keyframes achievementUnlock{
  0%{
    transform:scale(.8) rotateY(0deg);
    opacity:0;
  }
  50%{
    transform:scale(1.1) rotateY(180deg);
  }
  100%{
    transform:scale(1) rotateY(360deg);
    opacity:1;
  }
}

.achievement.locked{
  opacity:.3;
  filter:grayscale(1);
}

.achievement.locked:hover{
  opacity:.5;
  transform:translateY(-2px);
}

.achievement-icon{
  font-size:32px;
  transition:transform .3s;
}

.achievement.unlocked .achievement-icon{
  animation:iconBounce .6s ease-out;
}

@keyframes iconBounce{
  0%,100%{transform:scale(1)}
  50%{transform:scale(1.3)}
}

.achievement:hover .achievement-icon{
  transform:scale(1.1);
}

.achievement-name{
  font-size:12px;
  font-weight:600;
}

.achievement-desc{
  font-size:10px;
  color:var(--text2);
}

.tasks-list{
  display:flex;
  flex-direction:column;
  gap:8px;
}

.task-item{
  display:flex;
  align-items:center;
  gap:12px;
  padding:12px;
  background:var(--surface);
  border:1px solid var(--border);
  border-radius:12px;
}

.task-checkbox{
  width:20px;
  height:20px;
  border-radius:50%;
  border:2px solid var(--border);
  flex-shrink:0;
  transition:all .2s;
}

.task-item.completed .task-checkbox{
  background:var(--green);
  border-color:var(--green);
}

.task-text{
  flex:1;
  font-size:14px;
}

.task-reward{
  font-size:12px;
  color:var(--accent);
  font-weight:600;
}

/* ========== 👤 我的页 ========== */
.settings-list{
  padding:16px;
}

.setting-item{
  display:flex;
  align-items:center;
  gap:12px;
  padding:16px;
  background:var(--surface);
  border:1px solid var(--border);
  border-radius:12px;
  margin-bottom:8px;
  cursor:pointer;
  transition:all .2s;
  width:100%;
  text-align:left;
  color:var(--text);
  font-family:var(--font);
  font-size:15px;
}

.setting-item:active{
  transform:scale(.98);
  background:var(--surface2);
}

.setting-icon{font-size:20px;flex-shrink:0}
.setting-text{flex:1}
.setting-value{color:var(--text2);font-size:14px}
.setting-arrow{color:var(--text2);font-size:20px}

/* ========== 子页面 ========== */
.subview-header{
  display:flex;
  align-items:center;
  gap:12px;
  padding:12px 16px;
  background:var(--surface);
  border-bottom:1px solid var(--border);
}

.back-btn{
  width:36px;
  height:36px;
  border-radius:50%;
  border:none;
  background:var(--surface2);
  color:var(--text);
  font-size:24px;
  display:flex;
  align-items:center;
  justify-content:center;
  cursor:pointer;
  transition:all .2s;
}

.back-btn:active{
  transform:scale(.9);
}

.subview-header h2{
  flex:1;
  font-size:17px;
  font-weight:600;
  margin:0;
}

/* ========== 底部导航 ========== */
.bottom-nav{
  position:fixed;
  bottom:0;
  left:0;
  right:0;
  height:calc(var(--nav-height) + var(--safe-bottom));
  padding-bottom:var(--safe-bottom);
  background:var(--surface);
  border-top:1px solid var(--border);
  display:flex;
  justify-content:space-around;
  z-index:100;
}

.nav-tab{
  flex:1;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  gap:4px;
  border:none;
  background:none;
  color:var(--text2);
  cursor:pointer;
  transition:all .2s;
  padding:8px;
}

.nav-tab.active{
  color:var(--accent);
}

.tab-icon{
  font-size:24px;
  transition:transform .2s;
}

.nav-tab.active .tab-icon{
  transform:scale(1.1);
}

.tab-label{
  font-size:11px;
  font-weight:500;
}

/* ========== 弹窗 ========== */
.modal{
  position:fixed;
  inset:0;
  background:rgba(0,0,0,.7);
  backdrop-filter:blur(8px);
  display:flex;
  align-items:center;
  justify-content:center;
  z-index:1000;
  padding:20px;
}

.modal-card{
  background:var(--surface);
  border:1px solid var(--border);
  border-radius:24px;
  padding:24px;
  max-width:400px;
  width:100%;
  max-height:80vh;
  overflow-y:auto;
}

.onboarding-card{
  text-align:center;
}

.onboarding-logo{
  font-size:64px;
  margin-bottom:16px;
}

.onboarding-card h2{
  font-size:24px;
  font-weight:700;
  margin:0 0 8px;
}

.onboarding-card p{
  font-size:15px;
  color:var(--text2);
  margin:0 0 20px;
}

.onboarding-progress{
  height:4px;
  background:var(--border);
  border-radius:2px;
  overflow:hidden;
  margin-bottom:24px;
}

.progress-fill{
  height:100%;
  background:linear-gradient(90deg,var(--accent),var(--blue));
  transition:width .3s;
}

.onboarding-actions{
  display:flex;
  gap:12px;
  margin-top:24px;
}

.btn-text{
  flex:1;
  padding:12px;
  border:none;
  background:none;
  color:var(--text2);
  font-size:15px;
  font-weight:500;
  font-family:var(--font);
  cursor:pointer;
  border-radius:12px;
  transition:all .2s;
}

.btn-text:active{
  background:var(--surface2);
}

.btn-primary{
  flex:1;
  padding:12px;
  border:none;
  background:var(--accent);
  color:#fff;
  font-size:15px;
  font-weight:600;
  font-family:var(--font);
  cursor:pointer;
  border-radius:12px;
  transition:all .2s;
}

.btn-primary:active{
  transform:scale(.95);
  background:var(--accent-dark);
}

/* ========== Toast ========== */
#toast-container{
  position:fixed;
  top:20px;
  left:50%;
  transform:translateX(-50%);
  z-index:2000;
  display:flex;
  flex-direction:column;
  gap:8px;
  pointer-events:none;
}

.toast{
  background:var(--surface);
  border:1px solid var(--border);
  border-radius:16px;
  padding:12px 20px;
  font-size:14px;
  box-shadow:0 8px 32px rgba(0,0,0,.3);
  animation:toastSlide .3s cubic-bezier(.4,0,.2,1);
  pointer-events:auto;
}

@keyframes toastSlide{
  from{opacity:0;transform:translateY(-20px)}
  to{opacity:1;transform:translateY(0)}
}

.toast.success{
  background:linear-gradient(135deg,rgba(0,212,123,.2),rgba(0,212,123,.05));
  border-color:var(--green);
  color:var(--green);
}

.toast.achievement{
  background:linear-gradient(135deg,rgba(124,108,240,.2),rgba(77,159,255,.1));
  border-color:var(--accent);
  color:var(--accent);
  font-weight:600;
  animation:toastSlide .3s cubic-bezier(.4,0,.2,1), toastGlow 2s ease-in-out infinite;
}

@keyframes toastGlow{
  0%,100%{box-shadow:0 8px 32px rgba(0,0,0,.3)}
  50%{box-shadow:0 8px 32px rgba(124,108,240,.4), 0 0 20px rgba(124,108,240,.3)}
}

/* ========== XP增长动画 ========== */
@keyframes xpFloat{
  0%{
    opacity:0;
    transform:translateY(0) scale(.8);
  }
  20%{
    opacity:1;
    transform:translateY(-10px) scale(1);
  }
  100%{
    opacity:0;
    transform:translateY(-40px) scale(.8);
  }
}

.xp-float{
  position:fixed;
  top:50%;
  left:50%;
  transform:translate(-50%,-50%);
  font-size:32px;
  font-weight:700;
  color:var(--accent);
  pointer-events:none;
  z-index:9999;
  animation:xpFloat 1.5s ease-out forwards;
  text-shadow:0 2px 8px rgba(124,108,240,.5);
}

/* ========== 等级提升动画 ========== */
@keyframes levelUp{
  0%{
    opacity:0;
    transform:scale(.5) rotate(-10deg);
  }
  50%{
    opacity:1;
    transform:scale(1.2) rotate(5deg);
  }
  100%{
    opacity:0;
    transform:scale(.8) rotate(0deg);
  }
}

.level-up-effect{
  position:fixed;
  inset:0;
  display:flex;
  align-items:center;
  justify-content:center;
  background:rgba(0,0,0,.8);
  z-index:9999;
  pointer-events:none;
  animation:fadeOut 2s ease-out forwards;
}

.level-up-content{
  font-size:48px;
  font-weight:700;
  color:var(--accent);
  text-align:center;
  animation:levelUp 2s ease-out forwards;
  text-shadow:0 4px 16px rgba(124,108,240,.8);
}

@keyframes fadeOut{
  0%{opacity:1}
  70%{opacity:1}
  100%{opacity:0}
}

/* ========== 桌面端适配 ========== */
@media(min-width:768px){
  .app{
    max-width:480px;
    margin:0 auto;
    border-left:1px solid var(--border);
    border-right:1px solid var(--border);
  }
}

/* ========== Agent列表（子页面） ========== */
.agents-list{
  padding:16px;
  overflow-y:auto;
  flex:1;
}

.agent-card{
  background:var(--surface);
  border:1px solid var(--border);
  border-radius:16px;
  padding:16px;
  margin-bottom:12px;
}

.agent-card-header{
  display:flex;
  align-items:center;
  gap:10px;
  margin-bottom:12px;
}

.agent-role-badge{
  font-size:10px;
  padding:4px 8px;
  border-radius:8px;
  font-weight:600;
  text-transform:uppercase;
}

.agent-role-badge.orchestrator{
  background:rgba(124,108,240,.2);
  color:var(--accent);
}

.agent-role-badge.worker{
  background:rgba(0,212,123,.2);
  color:var(--green);
}

.agent-role-badge.specialist{
  background:rgba(255,160,64,.2);
  color:var(--orange);
}

.agent-card h3{
  font-size:16px;
  font-weight:600;
  margin:0;
}

.agent-card p{
  font-size:13px;
  color:var(--text2);
  line-height:1.6;
  margin:0 0 12px;
}

.agent-card-footer{
  display:flex;
  justify-content:space-between;
  align-items:center;
}

.agent-model{
  font-size:11px;
  color:var(--text2);
  background:var(--surface2);
  padding:4px 8px;
  border-radius:6px;
}

/* ========== 活动日志（子页面） ========== */
.activity-timeline{
  padding:16px;
  overflow-y:auto;
  flex:1;
}

.activity-item{
  display:flex;
  align-items:center;
  gap:12px;
  padding:12px;
  background:var(--surface);
  border:1px solid var(--border);
  border-radius:12px;
  margin-bottom:8px;
  border-left:3px solid var(--border);
}

.activity-item.user{
  border-left-color:var(--blue);
}

.activity-item.agent{
  border-left-color:var(--green);
}

.activity-item.memory{
  border-left-color:var(--accent);
}

.activity-item.tool{
  border-left-color:var(--orange);
}

.activity-item.system{
  border-left-color:var(--text2);
  opacity:.7;
}

.activity-icon{
  font-size:18px;
  flex-shrink:0;
}

.activity-time{
  font-size:11px;
  color:var(--text2);
  font-family:"SF Mono",Menlo,monospace;
  flex-shrink:0;
  min-width:50px;
}

.activity-detail{
  font-size:13px;
  color:var(--text);
  flex:1;
  word-break:break-word;
}
