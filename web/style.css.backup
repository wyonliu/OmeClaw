*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{--bg:#0a0a0f;--surface:#12121a;--surface2:#1a1a28;--border:#262638;--border-h:#3a3a52;--text:#eeeef2;--text2:#7a7a96;--accent:#7c6cf0;--accent2:#6b5ce0;--accent-bg:rgba(124,108,240,0.08);--green:#00d47b;--orange:#ffa040;--red:#ff5050;--blue:#4d9fff;--r:10px;--font:-apple-system,BlinkMacSystemFont,"Segoe UI","SF Pro",system-ui,sans-serif}
body{font-family:var(--font);background:var(--bg);color:var(--text);height:100vh;overflow:hidden;font-size:13px;line-height:1.5}
.app{display:flex;height:100vh}

/* Sidebar */
.sidebar{width:220px;background:var(--surface);border-right:1px solid var(--border);display:flex;flex-direction:column;padding:16px 12px;overflow-y:auto;flex-shrink:0}
.logo{font-size:17px;font-weight:700;padding:4px 8px 14px;letter-spacing:-0.5px;color:var(--accent);opacity:.95}
.bond-card{display:flex;align-items:center;gap:12px;padding:14px;margin:0 4px 14px;background:linear-gradient(135deg,var(--surface2),rgba(124,108,240,.04));border:1px solid var(--border);border-radius:14px;cursor:default;transition:all .25s}
.bond-card:hover{border-color:var(--accent);background:var(--accent-bg)}
.bond-emoji{font-size:30px;line-height:1;flex-shrink:0;animation:float 4s ease-in-out infinite}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-4px)}}
.bond-info{overflow:hidden}
.bond-name{font-size:14px;font-weight:600;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.bond-level{font-size:11px;color:var(--text2);margin-top:3px;display:flex;align-items:center;flex-wrap:wrap;gap:3px}
.sidebar-section{margin-bottom:10px}
.section-title{font-size:10px;text-transform:uppercase;color:var(--text2);padding:4px 8px 6px;letter-spacing:1.2px;font-weight:600}
.nav-btn{display:block;width:100%;padding:9px 12px;background:none;border:none;color:var(--text2);font-size:13px;text-align:left;border-radius:var(--r);cursor:pointer;transition:all .15s;font-family:var(--font)}
.nav-btn:hover{background:var(--surface2);color:var(--text)}
.nav-btn.active{background:var(--accent-bg);color:var(--accent);font-weight:600}
.agent-list .agent-item{display:flex;align-items:center;gap:8px;padding:7px 12px;border-radius:var(--r);cursor:pointer;color:var(--text2);font-size:12px;transition:all .15s}
.agent-item:hover{background:var(--surface2);color:var(--text)}
.agent-item.active{background:var(--accent-bg);color:var(--accent)}
.agent-item .dot{width:7px;height:7px;border-radius:50%;flex-shrink:0}
.agent-item .dot.orchestrator{background:var(--accent)}
.agent-item .dot.worker{background:var(--green)}
.agent-item .dot.specialist{background:var(--orange)}
.agent-item .dot.live{box-shadow:0 0 0 0 rgba(0,212,123,.7);animation:livePulse 1.6s infinite}
@keyframes livePulse{0%{box-shadow:0 0 0 0 rgba(0,212,123,.7)}70%{box-shadow:0 0 0 8px rgba(0,212,123,0)}100%{box-shadow:0 0 0 0 rgba(0,212,123,0)}}
.sidebar-footer{margin-top:auto;padding:12px 8px;font-size:11px;color:var(--text2);display:flex;align-items:center;gap:8px;border-top:1px solid var(--border)}
.status-dot{width:8px;height:8px;border-radius:50%;background:var(--green);flex-shrink:0}
.status-dot.off{background:var(--red)}

/* Content */
.content{flex:1;display:flex;flex-direction:column;overflow:hidden;min-width:0}
.view{display:none;flex:1;flex-direction:column;overflow:hidden}
.view.active{display:flex}
.view-header{display:flex;align-items:center;justify-content:space-between;padding:14px 24px;border-bottom:1px solid var(--border);gap:12px;flex-shrink:0}
.view-header h2{font-size:15px;font-weight:600;color:var(--text)}
.header-select{background:var(--surface2);border:1px solid var(--border);color:var(--text);padding:6px 12px;border-radius:var(--r);font-size:12px;outline:none;cursor:pointer;font-family:var(--font)}
.header-select:focus{border-color:var(--accent)}

/* Buttons */
.btn-primary{padding:7px 18px;background:var(--accent);border:none;color:#fff;border-radius:var(--r);cursor:pointer;font-size:12px;font-weight:500;transition:all .15s;font-family:var(--font)}
.btn-primary:hover{background:var(--accent2);transform:translateY(-1px)}
.btn-primary:disabled{opacity:.4;cursor:not-allowed;transform:none}
.btn-secondary{padding:7px 18px;background:var(--surface2);border:1px solid var(--border);color:var(--text);border-radius:var(--r);cursor:pointer;font-size:12px;font-family:var(--font);transition:all .15s}
.btn-secondary:hover{border-color:var(--border-h);background:var(--border)}

/* Bond mood */
.bond-mood{font-size:16px;flex-shrink:0}

/* Chat */
.header-actions{display:flex;align-items:center;gap:8px}
.icon-btn{width:34px;height:34px;display:flex;align-items:center;justify-content:center;border:1px solid var(--border);background:var(--surface2);border-radius:10px;cursor:pointer;font-size:14px;transition:all .15s;color:var(--text2)}
.icon-btn:hover{border-color:var(--accent);color:var(--accent)}
.icon-btn.active{background:var(--accent-bg);border-color:var(--accent);color:var(--accent)}
.mic-btn{flex-shrink:0}
.mic-btn.active{animation:micPulse 1s infinite;background:rgba(255,80,80,.15);border-color:var(--red);color:var(--red)}
@keyframes micPulse{0%,100%{box-shadow:0 0 0 0 rgba(255,80,80,.4)}50%{box-shadow:0 0 0 6px rgba(255,80,80,0)}}
.messages{flex:1;overflow-y:auto;padding:20px 24px;display:flex;flex-direction:column;gap:8px}
.msg{max-width:72%;padding:12px 16px;border-radius:16px;line-height:1.7;font-size:13.5px;word-break:break-word;animation:msgIn .25s ease}
@keyframes msgIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
.msg.user{align-self:flex-end;background:var(--accent);color:#fff;border-bottom-right-radius:4px;white-space:pre-wrap}
.msg.assistant{align-self:flex-start;background:var(--surface);border:1px solid var(--border);border-bottom-left-radius:4px}
.msg.error{border-color:var(--red);background:rgba(255,80,80,0.06)}
.msg .agent-tag{font-size:10px;color:var(--accent);margin-bottom:5px;display:block;font-weight:600;text-transform:uppercase;letter-spacing:0.5px}
.msg .agent-tag.error-tag{color:var(--red)}

/* Thinking */
.thinking{display:flex;gap:5px;align-items:center;padding:4px 0}
.thinking span{width:7px;height:7px;border-radius:50%;background:var(--accent);opacity:.4;animation:bounce 1.4s infinite ease-in-out both}
.thinking span:nth-child(1){animation-delay:-0.32s}
.thinking span:nth-child(2){animation-delay:-0.16s}
.thinking span:nth-child(3){animation-delay:0s}
@keyframes bounce{0%,80%,100%{transform:scale(0.5);opacity:.3}40%{transform:scale(1);opacity:1}}
.msg.loading{min-height:50px}
.msg pre{background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:10px 12px;margin:8px 0 4px;overflow-x:auto;font-size:12px;white-space:pre-wrap}
.msg code{background:var(--surface2);padding:1px 5px;border-radius:4px;font-size:12px;font-family:"SF Mono",Menlo,Monaco,monospace}
.msg pre code{background:none;padding:0}
.msg strong{font-weight:600;color:var(--accent)}
.chat-input{display:flex;padding:14px 24px;gap:10px;border-top:1px solid var(--border);background:var(--surface);flex-shrink:0}
.chat-input input{flex:1;padding:12px 16px;background:var(--bg);border:1px solid var(--border);color:var(--text);border-radius:12px;font-size:13px;outline:none;font-family:var(--font);transition:border-color .15s}
.chat-input input:focus{border-color:var(--accent);box-shadow:0 0 0 3px rgba(124,108,240,.1)}
.chat-input input::placeholder{color:var(--text2)}
#send-btn{padding:12px 24px;background:var(--accent);border:none;color:#fff;border-radius:12px;cursor:pointer;font-size:13px;font-weight:500;font-family:var(--font);transition:all .15s;white-space:nowrap}
#send-btn:hover{background:var(--accent2);transform:translateY(-1px)}

/* Cards */
.card-grid{padding:20px 24px;display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:14px;overflow-y:auto;flex:1}
.card{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:18px;transition:all .2s}
.card:hover{border-color:var(--border-h);transform:translateY(-2px);box-shadow:0 8px 24px rgba(0,0,0,.2)}
.card-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:8px}
.card h3{font-size:14px;font-weight:600}
.card p{font-size:12px;color:var(--text2);line-height:1.6;margin:4px 0}
.card-tags{display:flex;flex-wrap:wrap;gap:4px;margin-top:10px}
.agent-live{display:flex;align-items:center;gap:8px;font-size:11px;color:var(--text2);margin-bottom:8px;padding:8px 10px;border-radius:10px;background:var(--surface2);transition:all .3s}
.agent-live .live-dot{width:8px;height:8px;border-radius:50%;background:var(--text2);transition:all .3s}
.agent-live.alive{background:rgba(0,212,123,.06);border:1px solid rgba(0,212,123,.15)}
.agent-live.alive .live-dot{background:var(--green);animation:livePulse 1.6s infinite}
.agent-live .live-text{font-weight:600}
.agent-live .live-time{margin-left:auto;font-size:10px;opacity:.8}
.agent-live .live-runs{font-size:10px;color:var(--accent);font-weight:600}
.agent-preview{font-size:11px;color:var(--text2);padding:4px 0 8px;font-style:italic;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

/* Status */
#view-status{overflow-y:auto}
#view-status .card-grid{display:flex;flex-direction:column;gap:0;padding:20px 24px;max-width:540px;overflow:visible}
.status-hero{background:linear-gradient(135deg,var(--accent-bg),rgba(77,159,255,.06));border:1px solid var(--border);border-radius:14px;padding:24px;margin-bottom:20px;text-align:center}
.status-status{font-size:16px;font-weight:600;color:var(--green);display:flex;align-items:center;justify-content:center;gap:8px}
.pulse-dot{width:8px;height:8px;border-radius:50%;background:var(--green);animation:pulse 2s infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}
.status-uptime{font-size:12px;color:var(--text2);margin-top:6px}
.status-section{margin-bottom:14px;padding:14px 16px;background:var(--surface);border:1px solid var(--border);border-radius:12px}
.status-section-title{font-size:10px;text-transform:uppercase;letter-spacing:1px;color:var(--text2);margin-bottom:8px;font-weight:600}
.status-agents{display:flex;flex-direction:column;gap:6px}
.status-agent{display:flex;align-items:center;gap:8px;font-size:13px}
.agent-role-dot{width:6px;height:6px;border-radius:50%;flex-shrink:0}
.agent-role-dot.orchestrator{background:var(--accent)}
.agent-role-dot.worker{background:var(--green)}
.agent-role-dot.specialist{background:var(--orange)}
.agent-id{font-size:10px;color:var(--text2);margin-left:auto}
.status-tools{display:flex;flex-wrap:wrap;gap:6px}
.tool-tag{font-size:10px;padding:3px 8px;background:var(--surface2);border-radius:6px;color:var(--text2)}
.status-val{font-size:13px;color:var(--text)}
.status-audit{display:flex;flex-direction:column;gap:6px;margin-top:8px}
.audit-item{display:flex;justify-content:space-between;gap:8px;font-size:11px;padding:6px 8px;border-radius:6px;background:var(--surface2)}
.audit-item.ok{border-left:3px solid var(--green)}
.audit-item.bad{border-left:3px solid var(--orange)}
.audit-item span:last-child{color:var(--text2)}

/* Evolution */
.evolution-section{margin:20px 24px;padding:16px;background:var(--surface);border:1px solid var(--border);border-radius:14px;max-width:540px}
.evolution-title{font-size:13px;font-weight:600;color:var(--accent);margin-bottom:12px;display:flex;align-items:center;gap:6px}
.evolution-list{display:flex;flex-direction:column;gap:6px;max-height:200px;overflow-y:auto}
.evolution-item{display:flex;align-items:center;gap:10px;padding:8px 12px;background:var(--bg);border-radius:8px;font-size:12px}
.ev-emoji{font-size:14px}
.ev-time{color:var(--text2);font-size:10px;font-family:"SF Mono",Menlo,monospace;min-width:75px}
.ev-detail{color:var(--text);flex:1}

/* Bond */
.bond-progress{margin-top:6px}
.bond-progress-bar{height:4px;background:var(--border);border-radius:2px;overflow:hidden}
.bond-progress-fill{height:100%;background:linear-gradient(90deg,var(--accent),var(--blue));border-radius:2px;transition:width .5s ease}
.bond-level-text{font-weight:600}
.bond-stats{font-size:11px;color:var(--text2);margin-left:4px}
.bond-next{font-size:10px;color:var(--accent);margin-left:4px}
.tag{display:inline-block;padding:2px 8px;border-radius:6px;font-size:10px;font-weight:500}
.tag.role{background:var(--accent-bg);color:var(--accent)}
.tag.tool{background:rgba(0,212,123,0.08);color:var(--green)}
.tag.model{background:rgba(77,159,255,0.08);color:var(--blue)}

/* Timeline */
.timeline{flex:1;overflow-y:auto;padding:8px 12px;display:flex;flex-direction:column;gap:0}
.tl-row{display:flex;align-items:center;gap:6px;padding:5px 8px;font-size:12px;line-height:1.5;transition:background .1s;border-radius:4px}
.tl-row:hover{background:var(--surface2)}
.tl-icon{flex-shrink:0;width:18px;text-align:center;font-size:12px}
.tl-time{flex-shrink:0;width:82px;color:var(--text2);font-size:10px;font-family:"SF Mono",Menlo,monospace;opacity:.7}
.tl-label{flex-shrink:0;width:32px;font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.3px;color:var(--text2)}
.tl-src{flex-shrink:0;font-size:9px;padding:1px 5px;border-radius:4px;font-weight:600;text-transform:uppercase;letter-spacing:.4px}
.tl-src-web{background:rgba(124,108,240,.12);color:var(--accent)}
.tl-src-lark{background:rgba(77,159,255,.12);color:var(--blue)}
.tl-src-server{background:rgba(136,136,160,.08);color:var(--text2)}
.tl-detail{color:var(--text);word-break:break-word;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;flex:1;min-width:0}
.tl-row:hover .tl-detail{white-space:pre-wrap;overflow:visible}
.tl-user{border-left:3px solid var(--blue)}
.tl-user .tl-label{color:var(--blue)}
.tl-user .tl-detail{color:var(--blue);font-weight:500}
.tl-agent{border-left:3px solid var(--green)}
.tl-agent .tl-label{color:var(--green)}
.tl-tool{border-left:3px solid var(--orange);opacity:.65}
.tl-tool .tl-detail{color:var(--orange);font-size:11px}
.tl-tool .tl-label{color:var(--orange)}
.tl-memory{border-left:3px solid var(--accent)}
.tl-memory .tl-label{color:var(--accent)}
.tl-memory .tl-detail{color:var(--accent)}
.tl-system{border-left:3px solid var(--text2);opacity:.5}
.tl-system .tl-detail{color:var(--text2);font-size:11px;font-style:italic}
.tl-system .tl-label{color:var(--text2)}
.empty-msg{color:var(--text2);padding:24px;text-align:center;font-style:italic}

/* Welcome */
.welcome-msg{display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;text-align:center;gap:12px;color:var(--text2);padding:40px}
.welcome-icon{font-size:56px;margin-bottom:8px;animation:float 4s ease-in-out infinite}
.welcome-msg h3{font-size:20px;font-weight:600;color:var(--text);margin:0}
.welcome-msg p{font-size:13px;line-height:1.8;margin:0;max-width:360px}
.welcome-tips{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin-top:12px}
.welcome-tips span{padding:8px 16px;background:var(--surface2);border:1px solid var(--border);border-radius:20px;font-size:12px;color:var(--text2);cursor:pointer;transition:all .2s}
.welcome-tips span:hover{border-color:var(--accent);color:var(--accent);transform:translateY(-2px)}
.daily-prompt{margin:12px 0 4px;display:flex;align-items:center;gap:8px;flex-wrap:wrap;justify-content:center}
.daily-label{font-size:11px;color:var(--accent);font-weight:600}
.daily-prompt span[data-text]{padding:8px 16px;background:linear-gradient(135deg,var(--accent-bg),rgba(77,159,255,.06));border:1px solid var(--accent);border-radius:20px;font-size:13px;color:var(--accent);cursor:pointer;transition:all .2s;font-weight:500}
.daily-prompt span[data-text]:hover{transform:translateY(-2px);box-shadow:0 4px 12px rgba(124,108,240,.2)}

/* Memory */
.memory-view{flex:1;overflow-y:auto;padding:16px 24px}
.mem-overview{background:linear-gradient(135deg,var(--surface),rgba(124,108,240,.03));border:1px solid var(--border);border-radius:14px;padding:24px;margin-bottom:16px}
.mem-stats{display:flex;align-items:center;gap:16px}
.mem-stat-ring{position:relative;width:64px;height:64px;flex-shrink:0}
.mem-stat-ring svg{width:100%;height:100%;transform:rotate(-90deg)}
.ring-bg{fill:none;stroke:var(--border);stroke-width:3}
.ring-fill{fill:none;stroke:var(--accent);stroke-width:3;stroke-linecap:round;transition:stroke-dasharray .6s ease}
.ring-text{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:700;color:var(--accent)}
.mem-stat-info{flex:1}
.mem-stat-title{font-size:15px;font-weight:600;color:var(--text)}
.mem-stat-sub{font-size:11px;color:var(--text2);margin-top:2px}
.mem-identity{display:flex;gap:6px;margin-top:14px;flex-wrap:wrap}
.mem-id-tag{padding:5px 12px;background:var(--accent-bg);color:var(--accent);border-radius:8px;font-size:11px;font-weight:500}
.mem-categories{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:10px;margin-bottom:16px}
.mem-cat{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:14px;transition:all .2s}
.mem-cat:hover{border-color:var(--border-h);transform:translateY(-1px)}
.mem-cat-filled{border-left:3px solid var(--green)}
.mem-cat-empty{opacity:.45}
.mem-cat-header{display:flex;align-items:center;gap:8px;margin-bottom:8px}
.mem-cat-icon{font-size:16px}
.mem-cat-name{font-size:13px;font-weight:600;color:var(--text);flex:1}
.mem-cat-count{font-size:10px;background:var(--green);color:#000;padding:1px 6px;border-radius:8px;font-weight:600}
.mem-cat-facts{display:flex;flex-direction:column;gap:4px}
.mem-fact{display:flex;gap:8px;font-size:12px;line-height:1.5}
.mem-fact-key{color:var(--text2);flex-shrink:0;min-width:60px}
.mem-fact-val{color:var(--text);word-break:break-word}
.mem-cat-hint{font-size:11px;color:var(--text2);font-style:italic}
.mem-uncat{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:14px}
.mem-search-item{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:10px 14px;margin-bottom:6px}
.mem-role-tag{font-size:10px;font-weight:600;color:var(--accent);text-transform:uppercase;margin-right:8px}
.mem-time{font-size:10px;color:var(--text2)}
.mem-text{font-size:12px;color:var(--text);margin-top:4px;line-height:1.5;word-break:break-word}

/* Modal */
.modal{position:fixed;inset:0;background:rgba(0,0,0,.7);display:flex;align-items:center;justify-content:center;z-index:100;backdrop-filter:blur(6px)}
.modal-content{background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:28px;width:460px;max-width:92vw;box-shadow:0 24px 60px rgba(0,0,0,.5)}
.modal-content h3{margin-bottom:20px;font-size:16px;font-weight:600}
.modal-content label{display:block;margin-bottom:12px;font-size:12px;color:var(--text2);font-weight:500}
.modal-content input,.modal-content textarea,.modal-content select{display:block;width:100%;margin-top:5px;padding:9px 12px;background:var(--bg);border:1px solid var(--border);color:var(--text);border-radius:var(--r);font-size:13px;outline:none;font-family:var(--font);transition:border-color .15s}
.modal-content input:focus,.modal-content textarea:focus{border-color:var(--accent)}
.modal-content textarea{resize:vertical;min-height:60px}
.modal-actions{display:flex;gap:10px;justify-content:flex-end;margin-top:20px}

/* Search */
.search-group{display:flex;gap:8px}
.search-group input{padding:7px 14px;background:var(--bg);border:1px solid var(--border);color:var(--text);border-radius:var(--r);font-size:13px;outline:none;width:240px;font-family:var(--font);transition:border-color .15s}
.search-group input:focus{border-color:var(--accent)}
.mem-actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.mem-all-header{font-size:12px;color:var(--text2);margin-bottom:12px;padding-bottom:8px;border-bottom:1px solid var(--border)}
.mem-all-list{display:flex;flex-direction:column;gap:6px}
.mem-all-item{display:flex;gap:12px;padding:10px 14px;background:var(--surface);border:1px solid var(--border);border-radius:10px;font-size:13px;line-height:1.5}
.mem-all-item .mem-fact-key{color:var(--accent);font-weight:600;min-width:80px;flex-shrink:0}
.mem-all-item .mem-fact-val{color:var(--text);word-break:break-word}

/* Toast */
.toast{position:fixed;bottom:24px;right:24px;padding:12px 20px;border-radius:12px;font-size:13px;z-index:200;transform:translateY(20px);opacity:0;transition:all .3s ease;max-width:360px;box-shadow:0 8px 24px rgba(0,0,0,.3)}
.toast.show{transform:translateY(0);opacity:1}
.toast.success{background:var(--green);color:#000}
.toast.error{background:var(--red);color:#fff}
.toast.info{background:var(--accent);color:#fff}

/* Memory Toast */
#memory-toast-container{position:fixed;top:20px;left:50%;transform:translateX(-50%);z-index:300;display:flex;flex-direction:column;gap:8px;align-items:center;pointer-events:none}
.memory-toast{position:relative;padding:14px 28px;border-radius:14px;background:linear-gradient(135deg,rgba(124,108,240,.95),rgba(77,159,255,.9));color:#fff;font-size:13px;font-weight:500;letter-spacing:.3px;box-shadow:0 8px 32px rgba(124,108,240,.4),0 0 60px rgba(124,108,240,.15);opacity:0;transform:translateY(-20px) scale(.9);transition:all .5s cubic-bezier(.2,.8,.3,1);backdrop-filter:blur(8px);overflow:hidden}
.memory-toast.mt-show{opacity:1;transform:translateY(0) scale(1)}
.mt-glow{position:absolute;inset:-2px;border-radius:16px;background:linear-gradient(45deg,transparent,rgba(255,255,255,.2),transparent);animation:mt-shine 2s ease infinite}
.mt-text{position:relative;z-index:1}
.mt-sub{font-size:11px;opacity:.8;font-weight:400}
.memory-toast.achievement{background:linear-gradient(135deg,rgba(0,212,123,.95),rgba(77,159,255,.9));box-shadow:0 8px 32px rgba(0,212,123,.4),0 0 60px rgba(0,212,123,.15)}
@keyframes mt-shine{0%{opacity:0;transform:translateX(-100%)}50%{opacity:1}100%{opacity:0;transform:translateX(100%)}}

::-webkit-scrollbar{width:5px}
::-webkit-scrollbar-thumb{background:var(--border);border-radius:3px}
::-webkit-scrollbar-thumb:hover{background:var(--border-h)}

/* Onboarding */
.onboarding-content{max-width:480px;padding:32px}
.onboarding-header{display:flex;align-items:center;gap:12px;margin-bottom:20px}
.onboarding-logo{font-size:32px}
.onboarding-title-text{font-size:16px;font-weight:600;color:var(--text)}
.onboarding-progress{height:4px;background:var(--border);border-radius:2px;margin-bottom:24px;overflow:hidden}
.onboarding-progress-fill{height:100%;background:linear-gradient(90deg,var(--accent),var(--blue));transition:width .3s}
.onboarding-step{min-height:180px}
.onboarding-step h3{font-size:18px;margin-bottom:16px;color:var(--text)}
.onboarding-step p{font-size:13px;color:var(--text2);line-height:1.7;margin-bottom:20px}
.onboarding-input{width:100%;padding:14px 16px;background:var(--bg);border:1px solid var(--border);color:var(--text);border-radius:12px;font-size:14px;outline:none;font-family:var(--font);margin-top:8px;transition:border-color .15s}
.onboarding-input:focus{border-color:var(--accent);box-shadow:0 0 0 3px rgba(124,108,240,.1)}
.onboarding-actions{display:flex;gap:10px;justify-content:flex-end;margin-top:24px}

/* Radar Chart */
.mem-overview{display:flex;align-items:center;gap:24px;margin-bottom:24px;padding:16px;background:var(--surface2);border-radius:14px;border:1px solid var(--border)}
.mem-stat-ring{position:relative;width:56px;height:56px;flex-shrink:0}
.mem-stat-ring svg{width:56px;height:56px;transform:rotate(-90deg)}
.ring-bg{fill:none;stroke:var(--border);stroke-width:3}
.ring-fill{fill:none;stroke:var(--accent);stroke-width:3;stroke-linecap:round;transition:stroke-dasharray .6s ease}
.ring-text{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);font-size:11px;font-weight:700;color:var(--accent)}
.mem-stat-info{flex:1}
.mem-stat-title{font-weight:600;font-size:14px;color:var(--text);margin-bottom:4px}
.mem-stat-sub{font-size:11px;color:var(--text2)}
.mem-identity{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}
.mem-id-tag{padding:4px 10px;border-radius:12px;background:var(--accent-bg);color:var(--accent);font-size:11px;font-weight:500}
.mem-radar{display:flex;justify-content:center;margin-bottom:20px}
.radar-svg{width:220px;height:220px;max-width:100%}
.radar-svg text{fill:var(--text2);font-family:var(--font)}
.mem-categories{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:12px}
.mem-cat{background:var(--surface2);border:1px solid var(--border);border-radius:12px;padding:12px;transition:all .2s}
.mem-cat-filled{border-color:rgba(124,108,240,.2)}
.mem-cat-filled:hover{transform:translateY(-2px);box-shadow:0 4px 12px rgba(0,0,0,.08)}
.mem-cat-empty{opacity:.65}
.mem-cat-header{display:flex;align-items:center;gap:6px;margin-bottom:8px}
.mem-cat-icon{font-size:16px}
.mem-cat-name{font-weight:600;font-size:13px;color:var(--text)}
.mem-cat-count{margin-left:auto;padding:2px 8px;border-radius:10px;background:var(--accent-bg);color:var(--accent);font-size:10px;font-weight:600}
.mem-cat-facts{display:flex;flex-direction:column;gap:4px}
.mem-fact{display:flex;gap:6px;font-size:12px}
.mem-fact-key{color:var(--accent);font-weight:500;white-space:nowrap}
.mem-fact-val{color:var(--text);word-break:break-all}
.mem-cat-hint{font-size:11px;color:var(--text2);font-style:italic}
.mem-uncat{margin-top:16px;background:var(--surface2);border:1px solid var(--border);border-radius:12px;padding:12px}
.mem-all-header{font-size:12px;color:var(--text2);margin-bottom:8px}
.mem-all-list{display:flex;flex-direction:column;gap:4px}
.mem-all-item{display:flex;gap:6px;font-size:12px;padding:4px 0;border-bottom:1px solid var(--border)}

/* MBTI Test */
.mbti-options{display:flex;flex-direction:column;gap:10px;margin-top:16px}
.mbti-opt{padding:14px 20px;border:1px solid var(--border);border-radius:12px;background:var(--surface2);color:var(--text);font-size:14px;cursor:pointer;transition:all .15s;text-align:left;font-family:var(--font)}
.mbti-opt:hover{border-color:var(--accent);background:var(--accent-bg);transform:translateX(4px)}
.mbti-result{text-align:center;padding:24px}
.mbti-result h3{font-size:18px;color:var(--text);margin-bottom:12px}
.mbti-type{color:var(--accent);font-size:28px;font-weight:800;letter-spacing:2px}
.mbti-result p{color:var(--text2);font-size:13px}

/* Memory search */
.mem-search-item{padding:10px;border-bottom:1px solid var(--border);font-size:12px}
.mem-role-tag{display:inline-block;padding:2px 8px;border-radius:8px;background:var(--accent-bg);color:var(--accent);font-size:10px;font-weight:600;margin-right:6px}
.mem-time{color:var(--text2);font-size:10px}
.mem-text{margin-top:4px;color:var(--text);line-height:1.5}

/* Import */
#import-text{width:100%;padding:12px;background:var(--bg);border:1px solid var(--border);color:var(--text);border-radius:10px;font-size:13px;font-family:var(--font);line-height:1.6;resize:vertical;outline:none;transition:border-color .15s}
#import-text:focus{border-color:var(--accent)}

/* Toast achievement variant */
.memory-toast.achievement{background:linear-gradient(135deg,rgba(124,108,240,.18),rgba(254,174,0,.12))}
.mt-sub{font-size:11px;color:var(--text2);opacity:.8}

/* Bond progress */
.bond-progress-bar{height:3px;background:var(--border);border-radius:2px;margin-top:4px;overflow:hidden}
.bond-progress-fill{height:100%;background:linear-gradient(90deg,var(--accent),var(--blue));border-radius:2px;transition:width .4s}
.bond-stats{font-size:10px;color:var(--text2);font-weight:400}
.bond-next{font-size:9px;color:var(--accent);display:block;margin-top:2px}

/* ─── Mobile Bottom Nav (hidden on desktop) ─── */
.mobile-nav{display:none}

/* ─── Responsive: Mobile ─── */
@media(max-width:768px){
  /* Hide sidebar, show bottom nav */
  .sidebar{display:none}
  .mobile-nav{
    display:flex;position:fixed;bottom:0;left:0;right:0;z-index:90;
    background:var(--surface);border-top:1px solid var(--border);
    padding:6px 0 calc(6px + env(safe-area-inset-bottom));
    justify-content:space-around;align-items:center;
    backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px)
  }
  .mob-tab{
    display:flex;flex-direction:column;align-items:center;gap:2px;
    background:none;border:none;color:var(--text2);cursor:pointer;
    padding:6px 12px;border-radius:10px;transition:all .15s;
    -webkit-tap-highlight-color:transparent;font-family:var(--font)
  }
  .mob-tab.active{color:var(--accent)}
  .mob-tab .mob-icon{font-size:20px;line-height:1}
  .mob-tab .mob-label{font-size:10px;font-weight:500}

  /* App layout */
  .app{flex-direction:column}
  .content{flex:1;padding-bottom:calc(56px + env(safe-area-inset-bottom));overflow:hidden}

  /* Chat view - full screen */
  .view-header{padding:10px 16px;gap:8px}
  .view-header h2{font-size:14px}
  .header-actions{gap:6px}
  .header-select{padding:5px 8px;font-size:11px;max-width:120px}
  .messages{padding:12px 14px;gap:6px}
  .msg{max-width:88%;font-size:13px;padding:10px 14px;border-radius:14px}
  .msg .agent-tag{font-size:9px}

  /* Chat input */
  .chat-input{
    padding:10px 12px;
    gap:8px;position:relative;z-index:10
  }
  .chat-input input{padding:10px 14px;font-size:14px;border-radius:10px}
  #send-btn{padding:10px 16px;font-size:13px;border-radius:10px}
  .icon-btn{width:38px;height:38px;font-size:16px;border-radius:10px}

  /* Cards */
  .card-grid{padding:12px 14px;grid-template-columns:1fr;gap:10px;align-content:start}
  .card{padding:14px}

  /* Memory page */
  .memory-view{padding:12px 14px}
  .mem-actions{gap:4px;flex-wrap:wrap}
  .search-group{width:100%;order:-1}
  .search-group input{flex:1;width:auto;min-width:0}
  .mem-overview{padding:16px;margin-bottom:12px}
  .mem-stat-ring{width:48px;height:48px}
  .ring-text{font-size:11px}
  .mem-categories{grid-template-columns:1fr;gap:8px}
  .mem-cat{padding:12px}
  .mem-radar{margin-bottom:14px}
  .radar-svg{width:200px;height:200px}

  /* Status page */
  #view-status .card-grid{padding:12px 14px}
  .status-hero{padding:16px}
  .evolution-section{margin:12px 14px;padding:14px}

  /* Activity */
  .timeline{padding:4px 8px}
  .tl-row{padding:4px 6px;font-size:11px}
  .tl-time{width:60px;font-size:9px}
  .tl-label{width:28px;font-size:8px}

  /* Modals - mobile friendly */
  .modal{align-items:flex-end;padding:0}
  .modal-content{
    width:100%;max-width:100%;
    border-radius:20px 20px 0 0;
    padding:24px 20px calc(24px + env(safe-area-inset-bottom));
    max-height:85vh;overflow-y:auto;
    animation:modalSlideUp .25s ease
  }
  @keyframes modalSlideUp{from{transform:translateY(100%)}to{transform:translateY(0)}}
  .onboarding-content{max-width:100%;padding:24px 20px calc(24px + env(safe-area-inset-bottom))}

  /* Welcome */
  .welcome-msg{padding:24px 16px}
  .welcome-icon{font-size:42px}
  .welcome-msg h3{font-size:18px}
  .welcome-msg p{font-size:12px}
  .welcome-tips{gap:6px}
  .welcome-tips span{padding:6px 12px;font-size:11px}

  /* Toast */
  .toast{bottom:calc(70px + env(safe-area-inset-bottom));right:12px;left:12px;max-width:none;font-size:12px;padding:10px 16px}
  #memory-toast-container{top:auto;bottom:calc(120px + env(safe-area-inset-bottom))}

  /* Buttons touch targets */
  .btn-primary,.btn-secondary{min-height:36px;padding:8px 14px;font-size:12px}
  .mbti-opt{padding:16px 18px;font-size:15px;min-height:48px}

  /* Agent cards on mobile */
  .agent-card .card-header h3{font-size:13px}
  .agent-live{padding:6px 8px;font-size:10px}

  /* Daily prompt */
  .daily-prompt span[data-text]{font-size:12px;padding:6px 14px}
}

/* Small phone (SE, etc) */
@media(max-width:375px){
  .msg{max-width:92%;font-size:12px;padding:8px 12px}
  .view-header h2{font-size:13px}
  .chat-input input{font-size:13px}
  .mob-tab .mob-label{font-size:9px}
  .mob-tab .mob-icon{font-size:18px}
}
